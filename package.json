{
  "name": "si-stir-hebat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/guard-env.mjs",
    "build": "tsc -b && vite build && node scripts/check-demo-bundle.mjs dist",
    "build:isolated": "tsc --noEmit --pretty false -p tsconfig.app.json && tsc --noEmit --pretty false -p tsconfig.node.json && vite build --outDir dist-check --emptyOutDir && node scripts/check-demo-bundle.mjs dist-check",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "check": "node scripts/check-migrations.mjs && node scripts/check-ci.mjs && npm run lint && npm run typecheck && npm test && npm run build:isolated",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.app.json && tsc --noEmit --pretty false -p tsconfig.node.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.14.0",
    "pdfmake": "0.3.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "read-excel-file": "9.3.14",
    "unzipit": "2.1.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "supabase": "3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.72.2",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
